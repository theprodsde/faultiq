# ====================================================================
# FaultIQ Platform Environment Configuration
# ====================================================================
# 
# This file contains all environment variables used by FaultIQ services.
# Copy to .env.local (development) or .env.production for deployment.
#
# IMPORTANT: Never commit actual credentials. Use .env.local for secrets.
# ====================================================================

# ────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ────────────────────────────────────────────────────────────────────

# PostgreSQL settings (used by all services)
# Format: postgres://user:password@host:port/database?sslmode=disable
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=faultiq
PG_DSN=postgres://postgres:postgres@postgres:5432/faultiq?sslmode=disable

# Neo4j Graph Database
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpass123
# Services authenticate with NEO4J_PASS (not NEO4J_PASSWORD); keep these in sync.
NEO4J_PASS=testpass123
NEO4J_AUTH=neo4j/testpass123
NEO4J_URI=neo4j://neo4j:7687
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes

# ────────────────────────────────────────────────────────────────────
# CACHE CONFIGURATION
# ────────────────────────────────────────────────────────────────────

# Redis cache and pub/sub
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# ────────────────────────────────────────────────────────────────────
# SERVICE PORTS & ADDRESSES
# ────────────────────────────────────────────────────────────────────

# API Gateway (main entry point)
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8080
API_GATEWAY_ADDR=:8080

# Signal Ingestion Service (webhook receiver)
INGESTION_HOST=0.0.0.0
INGESTION_PORT=8085

# Detection Engine Service
DETECTION_ENGINE_HOST=0.0.0.0
DETECTION_ENGINE_PORT=8084

# Graph Manager Service
GRAPH_MANAGER_HOST=0.0.0.0
GRAPH_MANAGER_PORT=8086
GRAPH_MANAGER_ADDR=:8086
GRAPH_MANAGER_URL=http://graph-manager:8086

# Project Service
PROJECT_SERVICE_HOST=0.0.0.0
PROJECT_SERVICE_PORT=8081

# Onboarding Service
ONBOARDING_SERVICE_HOST=0.0.0.0
ONBOARDING_SERVICE_PORT=8082

# ────────────────────────────────────────────────────────────────────
# KEYCLOAK AUTHENTICATION
# ────────────────────────────────────────────────────────────────────

# Keycloak Admin Console Access
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak Realm and Clients
KEYCLOAK_REALM=faultiq
KEYCLOAK_CLIENT_ID=faultiq-ui
KEYCLOAK_CLIENT_SECRET=faultiq-ui-secret-change-in-production
KEYCLOAK_BACKEND_CLIENT_ID=faultiq-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=faultiq-backend-secret-change-in-production

# JWKS Configuration (for API Gateway JWT validation)
JWKS_URL=http://keycloak:8080/realms/faultiq/protocol/openid-connect/certs
JWKS_REFRESH_INTERVAL=1m
AUTH_MODE=jwks

# ────────────────────────────────────────────────────────────────────
# FRONTEND CONFIGURATION
# ────────────────────────────────────────────────────────────────────

# Frontend Application Settings
NEXT_PUBLIC_APP_NAME=FaultIQ
NEXT_PUBLIC_APP_ENV=development

# Browser-facing URLs are NOT set here. docker compose derives them from the
# HOST PORT MAPPINGS section at the bottom of this file, so changing a port in
# one place updates the whole stack:
#   NEXT_PUBLIC_API_GATEWAY_URL   <- API_GATEWAY_PUBLIC_PORT   + /api/v1
#   NEXT_PUBLIC_WEBSOCKET_URL     <- SIGNAL_INGESTION_PUBLIC_PORT
#   NEXT_PUBLIC_AUTH_URL          <- KEYCLOAK_PUBLIC_PORT
#   NEXT_PUBLIC_DEMO_SERVICES_URL <- DEMO_SERVICES_PUBLIC_PORT
#   NEXT_PUBLIC_HOST_URL          <- FRONTEND_PUBLIC_PORT
# Set any of them here only if you need to override the derived value.

# Keycloak Client Configuration
NEXT_PUBLIC_KEYCLOAK_REALM=faultiq
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=faultiq-ui

# Frontend Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_API_EXPLORER=true
NEXT_PUBLIC_ENABLE_DOCUMENTATION=true
NEXT_PUBLIC_ENABLE_MONITORING=true

# Frontend Runtime
# compose runs a production Next build via `next start`, so this must stay
# production — `next start` misbehaves under NODE_ENV=development.
NODE_ENV=production
NEXT_PUBLIC_DEBUG=false

# ────────────────────────────────────────────────────────────────────
# DETECTION ENGINE CONFIGURATION
# ────────────────────────────────────────────────────────────────────

# Namespace for initial graph loading
NAMESPACE=payments-platform:prod

# Root Cause Analysis (RCA) Scoring Weights
RCA_SCORE_DIRECT_SIGNAL=0.40
RCA_SCORE_SHARED_IMPACT=0.25
RCA_SCORE_BRANCH_ISOLATION=0.20
RCA_SCORE_LATENCY_ANOMALY=0.10
RCA_SCORE_RECENT_DEPLOYMENT=0.05

# ────────────────────────────────────────────────────────────────────
# CORS & SECURITY CONFIGURATION
# ────────────────────────────────────────────────────────────────────

# CORS Settings
ALLOWED_ORIGIN=*
ALLOW_CREDENTIALS=1

# ────────────────────────────────────────────────────────────────────
# LOGGING CONFIGURATION
# ────────────────────────────────────────────────────────────────────

# Log Level: debug, info, warn, error
LOG_LEVEL=info

# ────────────────────────────────────────────────────────────────────
# SOP – SEQUENCED FAULTS FOR AUTOMATION
# ────────────────────────────────────────────────────────────────────

# Health poller: interval between service health checks
POLL_INTERVAL_SECONDS=30

# Path to service-map.yaml (mounted as volume in docker-compose)
SERVICE_MAP_FILE=/etc/health-poller/service-map.yaml

# Webhook notification URL — receives POST when root cause is CONFIRMED.
# Examples:
#   Slack:     https://hooks.slack.com/services/T.../B.../xxx
#   PagerDuty: https://events.pagerduty.com/v2/enqueue
#   Custom:    http://my-alerting-service/webhook
# Leave empty to disable notifications.
NOTIFICATION_WEBHOOK_URL=

# Priority-based webhook routing
# NOTE: keep these values empty on their own line. Docker Compose does not strip
# trailing inline comments, so "VAR=  # comment" makes the comment the value.
# PagerDuty/OpsGenie for P1 faults (service-down, cascading)
P1_WEBHOOK_URL=
# Slack/Teams for P2 faults (latency, transient)
P2_WEBHOOK_URL=

# RCA confidence threshold to advance NARROWING → CONFIRMED
RCA_CONFIDENCE_THRESHOLD=0.75

# ────────────────────────────────────────────────────────────────────
# DOCKER COMPOSE SPECIFIC
# ────────────────────────────────────────────────────────────────────

# Used in docker-compose to identify the compose stack
COMPOSE_PROJECT_NAME=faultiq

# ────────────────────────────────────────────────────────────────────
# SERVICE AUTHENTICATION KEYS
# ────────────────────────────────────────────────────────────────────

# OTel Receiver API key (leave empty to disable auth in dev)
OTEL_API_KEY=

# Kubernetes Connector API key (leave empty to disable auth in dev)
K8S_CONNECTOR_API_KEY=

# ────────────────────────────────────────────────────────────────────
# MACHINE-TO-MACHINE AUTHENTICATION (CI/CD)
# ────────────────────────────────────────────────────────────────────

# Machine-to-machine authentication (for CI/CD pipelines)
# Set a strong random value: openssl rand -hex 32
API_KEY_SECRET=
DEFAULT_TENANT=acme-corp

# ────────────────────────────────────────────────────────────────────
# INTERNAL SERVICE WIRING
# ────────────────────────────────────────────────────────────────────
# docker-compose fills these in from .env so nothing is hardcoded in
# docker-compose.yml. Override them only if you change service names or
# in-network ports. Note the host part uses the service name, not localhost:
# these are resolved inside the compose network.

RCA_RANKER_URL=http://rca-ranker:8087
CODE_INDEXER_URL=http://code-indexer:8092
RECOMMENDATION_SERVICE_URL=http://recommendation:8090
API_GATEWAY_URL=http://api-gateway:8080
SIGNAL_INGESTION_URL=http://signal-ingestion:8085
K8S_CONNECTOR_URL=http://k8s-connector:8093
RCA_RANKER_ADDR=:8087
CODE_INDEXER_PORT=8092
DEMO_SERVICES_PORT=8091
OTEL_RECEIVER_PORT=4318
SLA_ESCALATION_MINUTES=30
INDEX_INTERVAL_MINUTES=60
POLL_INTERVAL_SECONDS=30
OTEL_DEFAULT_NAMESPACE=otel-auto:prod

# Service map paths as mounted into each container
ONBOARDING_SERVICE_MAP_FILE=/etc/onboarding/service-map.yaml
CODE_INDEXER_SERVICE_MAP_FILE=/etc/code-indexer/service-map.yaml
HEALTH_POLLER_SERVICE_MAP_FILE=/etc/health-poller/service-map.yaml

# ────────────────────────────────────────────────────────────────────
# HOST PORT MAPPINGS
# ────────────────────────────────────────────────────────────────────
# Change these if something already listens on a port on your machine.
# The defaults are what the README and screenshots reference.

FRONTEND_PUBLIC_PORT=4001
API_GATEWAY_PUBLIC_PORT=8080
KEYCLOAK_PUBLIC_PORT=8081
SIGNAL_INGESTION_PUBLIC_PORT=8085
GRAPH_MANAGER_PUBLIC_PORT=8086
RCA_RANKER_PUBLIC_PORT=8087
RECOMMENDATION_PUBLIC_PORT=8090
DEMO_SERVICES_PUBLIC_PORT=8091
CODE_INDEXER_PUBLIC_PORT=8092
K8S_CONNECTOR_PUBLIC_PORT=8093
OTEL_RECEIVER_PUBLIC_PORT=4318
NEO4J_HTTP_PUBLIC_PORT=7474
NEO4J_BOLT_PUBLIC_PORT=7687
POSTGRES_PUBLIC_PORT=5434
REDIS_PUBLIC_PORT=6380
K8S_CONNECTOR_PORT=8093
